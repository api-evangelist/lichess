                {
                  "name": "Get best ongoing games of a TV channel",
                  "id": "1f9348ad-dfc8-4237-8574-67050c997e39",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/x-chess-pgn"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/api/tv/:channel?nb=10&moves=true&pgnInJson=false&tags=true&clocks=false&opening=false",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "tv",
                        ":channel"
                      ],
                      "query": [
                        {
                          "description": "Number of games to fetch.",
                          "key": "nb",
                          "value": "10"
                        },
                        {
                          "description": "Include the PGN moves.",
                          "key": "moves",
                          "value": "true"
                        },
                        {
                          "description": "Include the full PGN within the JSON response, in a `pgn` field.",
                          "key": "pgnInJson",
                          "value": "false"
                        },
                        {
                          "description": "Include the PGN tags.",
                          "key": "tags",
                          "value": "true"
                        },
                        {
                          "description": "Include clock status when available.\nEither as PGN comments: `2. exd5 { [%clk 1:01:27] } e5 { [%clk 1:01:28] }`\nOr in a `clocks` JSON field, as centisecond integers, depending on the response type.\n",
                          "key": "clocks",
                          "value": "false"
                        },
                        {
                          "description": "Include the opening name.\nExample: `[Opening \"King's Gambit Accepted, King's Knight Gambit\"]`\n",
                          "key": "opening",
                          "value": "false"
                        }
                      ],
                      "variable": [
                        {
                          "id": "367f8567-cce2-4b44-899c-f463dece9558",
                          "key": "channel",
                          "value": "<string>",
                          "description": "(Required) The name of the channel in camel case."
                        }
                      ]
                    },
                    "description": "Get a list of ongoing games for a given TV channel. Similar to [lichess.org/games](https://lichess.org/games).\nAvailable in PGN or [ndjson](#description/streaming-with-nd-json) format, depending on the request `Accept` header.\n"
                  },
